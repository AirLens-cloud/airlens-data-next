{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AirLens-cloud/airlens-data/contracts/evidence-envelope.v1.schema.json",
  "title": "EvidenceEnvelope v1",
  "description": "EVIDENCE_CONTRACT.md §2 — minimal unit for every user-exposed value. Producer/consumer both validate against this; a value without an envelope is not renderable per §6-1.",
  "type": "object",
  "required": [
    "schemaVersion",
    "receiptId",
    "phenomenon",
    "value",
    "unit",
    "nature",
    "time",
    "space",
    "source",
    "quality",
    "lineage"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "receiptId": { "type": "string", "minLength": 1 },
    "phenomenon": { "type": "string", "minLength": 1 },
    "value": {
      "description": "T | null — EVIDENCE_CONTRACT.md §1-1: null is an explicit state, never replaced by a fabricated default."
    },
    "unit": { "type": "string" },
    "nature": {
      "enum": [
        "observation",
        "analysis",
        "interpolated",
        "forecast",
        "satellite-derived",
        "inferred",
        "policy"
      ]
    },
    "time": {
      "type": "object",
      "required": ["validStart", "ingestedAt", "publishedAt"],
      "additionalProperties": false,
      "properties": {
        "eventTime": { "type": "string", "format": "date-time" },
        "referenceTime": { "type": "string", "format": "date-time" },
        "validStart": { "type": "string", "format": "date-time" },
        "validEnd": { "type": "string", "format": "date-time" },
        "ingestedAt": { "type": "string", "format": "date-time" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geometry": { "type": "object" },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "resolution": { "type": "string" },
        "h3": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["sourceId", "provider", "licenseCode", "attribution"],
      "additionalProperties": false,
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "upstreamDataset": { "type": "string" },
        "licenseCode": { "type": "string" },
        "attribution": { "type": "string" }
      }
    },
    "quality": {
      "type": "object",
      "required": ["tier", "status"],
      "additionalProperties": false,
      "properties": {
        "tier": { "enum": ["reference", "low-cost", "model", "community", "unknown"] },
        "freshness": { "type": "number" },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "agreement": { "type": "number" },
        "stability": { "type": "number" },
        "status": {
          "enum": ["ready", "partial", "stale", "withheld", "no-coverage", "unavailable"]
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "if": {
        "properties": { "status": { "enum": ["withheld", "no-coverage"] } },
        "required": ["status"]
      },
      "then": {
        "description": "EVIDENCE_CONTRACT.md §7: withheld/no-coverage requires reason — conformance-tested.",
        "required": ["reason"]
      }
    },
    "uncertainty": {
      "description": "EVIDENCE_CONTRACT.md §1-3 — only present when method + calibration snapshot exist. Absent, not a fabricated band.",
      "type": "object",
      "required": ["method", "lower", "upper", "coverage"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "coverage": { "type": "number" },
        "calibrationSnapshotId": { "type": "string" }
      }
    },
    "lineage": {
      "type": "object",
      "required": ["datasetVersion", "transformations", "artifactSha256"],
      "additionalProperties": false,
      "properties": {
        "datasetVersion": { "type": "string" },
        "transformations": { "type": "array", "items": { "type": "string" } },
        "artifactSha256": { "type": "string" },
        "codeSha": { "type": "string" }
      }
    }
  }
}
